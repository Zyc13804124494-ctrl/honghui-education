# ===== 鸿慧教育 环境变量模板 =====
# 复制本文件为 .env.local 并在本地填写；生产环境请在 Vercel 项目 Settings → Environment Variables 配置同名变量。
#
# Supabase 项目地址（形如 https://xxxx.supabase.co）
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase Publishable Key（即 anon key，可安全暴露在客户端；切勿在此填写 service_role key）
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

